# Proxy Security
PROXY_API_KEYS=changeme-key1,changeme-key2 # Comma-separated list of valid keys for clients
TLS_ENABLED=true
TLS_CERT_FILE=tmp/server-cert.pem
TLS_KEY_FILE=tmp/server-key.pem
CA_TLS_ENABLED=false
CA_TLS_CERT_FILE=tmp/ca-cart.pem
CA_TLS_VERIFY=false

# Fabric CA Configuration
FABRIC_CA_SERVER_URL=http://fabric-ca.example.com:7054

# ServiceNow Configuration
SERVICENOW_INSTANCE=yourcompany.service-now.com
SERVICENOW_TABLE=change_request # Or incident, sc_req_item, etc.
SERVICENOW_USER=your_api_user
SERVICENOW_PASSWORD="YourVerySecurePassword"
SERVICENOW_ID_FIELD=number # Optional: defaults to number
SERVICENOW_APPROVAL_FIELD=state # IMPORTANT: Replace with your field name
SERVICENOW_APPROVAL_VALUE=3 # IMPORTANT: Replace with your 'Approved' value

# Application Configuration
PORT=5002
FLASK_DEBUG=False # Set to True ONLY for local development
