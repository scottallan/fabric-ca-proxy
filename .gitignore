scratch
# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment folders
venv/
.venv/
env/
.env/ # Also ignore hidden .env folder sometimes created by tools

#pcap files and data
*.pcap
*.pcap.*

#Key Material - CRITICAL
*.key
*.pem
