.env
.env.*
!*.env.example # Allow example file in git

# IDE configuration folders/files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
